{
  "title": "Melbourne Metro Train Station Patronage (2024-25 Financial Year)",
  "width": 600,
  "height": 500,
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "projection": {
    "type": "mercator",
    "center": [144.96, -37.81],
    "scale": 19000
  },
  "params": [
    {
      "name": "colorField",
      "value": "Pax_weekday",
      "bind": {
        "input": "select",
        "options": [
          "Pax_annual",
          "Pax_weekday",
          "Pax_norm_weekday",
          "Pax_sch_hol_weekday",
          "Pax_Saturday",
          "Pax_Sunday",
          "Pax_pre_AM_peak",
          "Pax_AM_peak",
          "Pax_interpeak",
          "Pax_PM_peak",
          "Pax_PM_late"
        ],
        "labels": [
          "Annual Patronage",
          "Weekday Patronage",
          "Non School Holiday Weekday",
          "School Holiday Weekday",
          "Saturday Patronage",
          "Sunday Patronage",
          "Pre Morning Peak",
          "Morning Peak",
          "Interpeak",
          "Evening Peak",
          "Late Night"
        ],
        "name": "Colour By: "
      }
    },
    {
      "name": "legendTitle",
      "expr": "({'Pax_annual':'Annual Patronage','Pax_weekday':'Weekday Patronage','Pax_norm_weekday':'Non School Holiday Weekday','Pax_sch_hol_weekday':'School Holiday Weekday','Pax_Saturday':'Saturday Patronage','Pax_Sunday':'Sunday Patronage','Pax_pre_AM_peak':'Pre Morning Peak','Pax_AM_peak':'Morning Peak','Pax_interpeak':'Interpeak','Pax_PM_peak':'Evening Peak','Pax_PM_late':'Late Night'})[colorField]"
    }
  ],
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "projection": {"type": "mercator"},
      "mark": {"type": "geoshape", "fill": "#a3cdff"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/zacg000/3179/refs/heads/main/js/STE_2021_AUST_GDA2020.json",
        "format": {"type": "topojson", "feature": "STE_2021_AUST_GDA2020"}
      },
      "mark": {"type": "geoshape", "fill": "#cfe0aa", "stroke": "black", "strokeWidth": 0.5}
    },
    {
      "data": {
        "values": [
          {
            "lat": -37.373501,
            "lon": 145.55,
            "lat2": -37.373501,
            "lon2": 145.66319
          }
        ]
      },
      "mark": {"type": "rule", "strokeWidth": 3, "color": "black"},
      "encoding": {
        "latitude": {"field": "lat"},
        "latitude2": {"field": "lat2"},
        "longitude": {"field": "lon"},
        "longitude2": {"field": "lon2"}
      }
    },
    {
      "data": {"values": [{"lat": -37.37, "lon": 145.605, "label": "10 km"}]},
      "mark": {"type": "text", "align": "center", "baseline": "bottom"},
      "encoding": {
        "latitude": {"field": "lat"},
        "longitude": {"field": "lon"},
        "text": {"field": "label"}
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/zacg000/3179/refs/heads/main/js/greater_melbourne.topojson",
        "format": {"type": "topojson", "feature": "greater_melbourne"}
      },
      "mark": {"type": "geoshape", "fill": "#efe8d4", "stroke": "black", "strokeWidth": 0.5}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/zacg000/3179/refs/heads/main/data/annual_metropolitan_train_station_entries_fy_2024_2025.csv",
        "format": {"type": "csv"}
      },
      "transform": [
        {
          "calculate": "datum[colorField]",
          "as": "SelectedColorField"
        }
      ],
      "mark": {"type": "circle"},
      "encoding": {
        "latitude": {"field": "Stop_lat", "type": "quantitative"},
        "longitude": {"field": "Stop_long", "type": "quantitative"},
        "size": {
          "field": "Pax_annual",
          "type": "quantitative",
          "title": "Annual Patronage",
          "scale": {"type": "sqrt", "domain": [0, 20000000]},
          "legend": {
            "orient": "left",
            "labelAlign": "left",
            "titleAlign": "left"
          }
        },
        "color": {
          "field": "SelectedColorField",
          "type": "quantitative",
          "scale": {"scheme": "bluegreen"},
          "legend": {"title": {"signal": "legendTitle"},
            "orient": "left",
            "labelAlign": "left",
            "titleAlign": "left"}
        },
        "tooltip": [
          {"field": "Stop_name", "title": "Train Station"},
          {"field": "Pax_annual", "title": "Annual Patronage", "format": ","},
          {"field": "Pax_weekday", "title": "Weekday Patronage", "format": ","},
          {
            "field": "Pax_norm_weekday",
            "title": "Non School Holiday Weekday Patronage",
            "format": ","
          },
          {
            "field": "Pax_sch_hol_weekday",
            "title": "School Holiday Weekday Patronage",
            "format": ","
          },
          {
            "field": "Pax_Saturday",
            "title": "Saturday Patronage",
            "format": ","
          },
          {"field": "Pax_Sunday", "title": "Sunday Patronage", "format": ","},
          {
            "field": "Pax_pre_AM_peak",
            "title": "Patronage before Morning Peak",
            "format": ","
          },
          {
            "field": "Pax_AM_peak",
            "title": "Morning Peak Patronage",
            "format": ","
          },
          {
            "field": "Pax_interpeak",
            "title": "Interpeak Patronage",
            "format": ","
          },
          {
            "field": "Pax_PM_peak",
            "title": "Evening Peak Patronage",
            "format": ","
          },
          {
            "field": "Pax_PM_late",
            "title": "Late Night Patronage",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/zacg000/3179/refs/heads/main/data/annual_metropolitan_train_station_entries_fy_2024_2025.csv",
        "format": {"type": "csv"}
      },
      "transform": [
        {
          "filter": "datum.Stop_name === 'Flinders Street' || datum.Stop_name === 'Cranbourne' || datum.Stop_name === 'Werribee' || datum.Stop_name === 'Frankston' || datum.Stop_name === 'Craigieburn' || datum.Stop_name === 'Lilydale' || datum.Stop_name === 'Dandenong'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "dy": 0,
        "font": "sans-serif",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "black"
      },
      "encoding": {
        "latitude": {"field": "Stop_lat", "type": "quantitative"},
        "longitude": {"field": "Stop_long", "type": "quantitative"},
        "text": {"field": "Stop_name"}
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/zacg000/3179/refs/heads/main/js/ne_10m_graticules_1.json",
        "format": {"type": "topojson", "feature": "ne_10m_graticules_1"}
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "grey",
        "strokeWidth": 0.5
      }
    }
  ],
  "config": {
  }
}