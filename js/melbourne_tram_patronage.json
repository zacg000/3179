{
  "title": "Melbourne Tram Stop Patronage (2018-19 Financial Year)",
  "width": 600,
  "height": 500,
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "projection": {
    "type": "mercator",
    "center": [145, -37.81],
    "scale": 80000
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {"type": "geoshape", "fill": "#a3cdff"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/zacg000/3179/refs/heads/main/js/STE_2021_AUST_GDA2020.json",
        "format": {"type": "topojson", "feature": "STE_2021_AUST_GDA2020"}
      },
      "mark": {"type": "geoshape", "fill": "#cfe0aa", "stroke": "black", "strokeWidth": 0.5}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/zacg000/3179/refs/heads/main/js/greater_melbourne.topojson",
        "format": {"type": "topojson", "feature": "greater_melbourne"}
      },
      "mark": {"type": "geoshape", "fill": "#efe8d4", "stroke": "black", "strokeWidth": 0.5}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/zacg000/3179/refs/heads/main/data/annual_tram_entries_2018-21.csv",
        "format": {"type": "csv"}
      },
      "mark": {"type": "circle"},
      "encoding": {
        "latitude": {"field": "Stop_lat", "type": "quantitative"},
        "longitude": {"field": "Stop_long", "type": "quantitative"},
        "color": {
          "field": "2018-19",
          "type": "quantitative",
          "title": "Annual Patronage",
          "scale": {"scheme" : "reds", "type": "sqrt", "domain": [0, 1150000]}
        },
        "tooltip": [
          {"field": "Stop_name", "title": "Tram Stop"},
          {"field": "2018-19", "title": "Annual Patronage (2018-19)", "format": ","},
          {"field": "2019-20", "title": "Annual Patronage (2019-20)", "format": ","},
          {"field": "2020-21", "title": "Annual Patronage (2020-21)", "format": ","}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/zacg000/3179/refs/heads/main/js/ne_10m_graticules_1.json",
        "format": {"type": "topojson", "feature": "ne_10m_graticules_1"}
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "grey",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "values": [
          {
            "lat": -37.685,
            "lon": 145.08,
            "lat2": -37.685,
            "lon2": 145.19319
          }
        ]
      },
      "mark": {"type": "rule", "strokeWidth": 3, "color": "black"},
      "encoding": {
        "latitude": {"field": "lat"},
        "latitude2": {"field": "lat2"},
        "longitude": {"field": "lon"},
        "longitude2": {"field": "lon2"}
      }
    },
    {
      "data": {"values": [{"lat": -37.68, "lon": 145.14, "label": "10 km"}]},
      "mark": {"type": "text", "align": "center", "baseline": "bottom"},
      "encoding": {
        "latitude": {"field": "lat"},
        "longitude": {"field": "lon"},
        "text": {"field": "label"}
      }
    }
  ],
